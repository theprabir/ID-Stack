    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>IDStack.Core</RootNamespace>
    <AssemblyName>IDStack.Core</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.2.0</Version>
