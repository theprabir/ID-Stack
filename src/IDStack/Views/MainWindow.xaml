<Window x:Class="IDStack.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AppTitle}"
        Icon="/Assets/app.ico"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewTemplateCommand}" />
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenTemplateCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveTemplateCommand}" />
        <KeyBinding Modifiers="Control" Key="E" Command="{Binding ImportExcelCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{Binding MenuFileHeader}">
                <MenuItem Header="{Binding MenuNewTemplateHeader}" Command="{Binding NewTemplateCommand}"
                          InputGestureText="Ctrl+N" />
                <MenuItem Header="{Binding MenuOpenTemplateHeader}" Command="{Binding OpenTemplateCommand}"
                          InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="{Binding MenuImportExcelHeader}" Command="{Binding ImportExcelCommand}"
                          InputGestureText="Ctrl+E" />
                <Separator />
                <MenuItem Header="{Binding MenuExitHeader}" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="{Binding MenuSettingsHeader}" Command="{Binding OpenSettingsCommand}" />
            <MenuItem Header="{Binding MenuHelpHeader}">
                <MenuItem Header="{Binding MenuAboutHeader}" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar navigation -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,18">
                        <TextBlock Text="{Binding AppTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SidebarTextBrush}" />
                    </Border>

                    <ListBox x:Name="NavList"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedValuePath="Key"
                             SelectedValue="{Binding CurrentPageKey, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="14"
                                           Padding="10,8" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
                                <Setter Property="Padding" Value="4" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border"
                                                    Background="Transparent"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background"
                                                            Value="{StaticResource SidebarHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background"
                                                            Value="{StaticResource SidebarActiveBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Language selector (top-right of content area) -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="16,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock.Resources>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}" />
                            </TextBlock.Resources>
                            <ComboBox MinWidth="140"
                                      ItemsSource="{Binding AvailableLanguages}"
                                      SelectedValuePath="CultureCode"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValue="{Binding CurrentLanguage, Mode=TwoWay}" />
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentPageTitle}" />
                    </DockPanel>
                </Border>

                <!-- Page content -->
                <ContentControl Content="{Binding CurrentViewModel}" />

                <!-- Status bar -->
                <StatusBar DockPanel.Dock="Bottom" Height="26">
                    <StatusBarItem>
                        <TextBlock Text="{Binding StatusText}" />
                    </StatusBarItem>
                </StatusBar>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
