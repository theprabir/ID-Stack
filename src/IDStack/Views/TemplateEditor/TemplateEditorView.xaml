<UserControl x:Class="IDStack.Views.TemplateEditor.TemplateEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IDStack.Views.TemplateEditor">

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="New"
                        Command="{Binding NewCommand}" Margin="0,0,4,0" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Open"
                        Command="{Binding OpenCommand}" Margin="0,0,4,0" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Save"
                        Command="{Binding SaveCommand}" Margin="0,0,12,0" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Undo"
                        Command="{Binding UndoCommand}" Margin="0,0,4,0" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Redo"
                        Command="{Binding RedoCommand}" Margin="0,0,12,0" />
                <RadioButton Content="Front" IsChecked="{Binding SelectedSideType, Converter={StaticResource SideTypeToBoolConverter}, ConverterParameter=Front, Mode=TwoWay}"
                             Command="{Binding SwitchToFrontCommand}" Margin="0,0,4,0" VerticalAlignment="Center" />
                <RadioButton Content="Back" IsChecked="{Binding SelectedSideType, Converter={StaticResource SideTypeToBoolConverter}, ConverterParameter=Back, Mode=TwoWay}"
                             Command="{Binding SwitchToBackCommand}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="−"
                        Command="{Binding ZoomOutCommand}" Margin="0,0,2,0" Width="28" />
                <TextBlock Text="{Binding ZoomPercentText}"
                           VerticalAlignment="Center" Width="46" TextAlignment="Center" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="+"
                        Command="{Binding ZoomInCommand}" Margin="0,0,4,0" Width="28" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <!-- Tools panel -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="6">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Tools" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="T  Text"
                            Command="{Binding AddTextCommand}" Margin="0,2" HorizontalAlignment="Stretch" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="🖼  Image"
                            Command="{Binding AddImageCommand}" Margin="0,2" HorizontalAlignment="Stretch" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="▭  Rectangle"
                            Command="{Binding AddRectangleCommand}" Margin="0,2" HorizontalAlignment="Stretch" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="◯  Ellipse"
                            Command="{Binding AddEllipseCommand}" Margin="0,2" HorizontalAlignment="Stretch" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="／  Line"
                            Command="{Binding AddLineCommand}" Margin="0,2" HorizontalAlignment="Stretch" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="▤  Barcode"
                            Command="{Binding AddBarcodeCommand}" Margin="0,2" HorizontalAlignment="Stretch" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{}{{x}}  Placeholder"
                            Command="{Binding AddPlaceholderCommand}" Margin="0,2" HorizontalAlignment="Stretch" />
                    <Separator Margin="0,8" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Duplicate"
                            Command="{Binding DuplicateSelectedCommand}" Margin="0,2" HorizontalAlignment="Stretch" />
                    <Button Style="{StaticResource DangerButtonStyle}" Content="Delete"
                            Command="{Binding DeleteSelectedCommand}" Margin="0,2" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <!-- Canvas -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceHoverBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Margin="2,6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="CanvasHost" Margin="24" />
                </ScrollViewer>
            </Border>

            <!-- Layers panel -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeaderStyle}" Text="Layers" />
                    <ListBox ItemsSource="{Binding Layers.Elements}"
                             SelectedItem="{Binding SelectedElement, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2">
                                    <Button DockPanel.Dock="Right" Width="22" Height="22" Padding="0"
                                            Content="{Binding IsVisible, Converter={StaticResource BoolToEyeConverter}}"
                                            Command="{Binding DataContext.Layers.ToggleVisibilityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Properties panel -->
            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Margin="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Properties" />
                        <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="X (mm)" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Properties.X, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="Y (mm)" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Properties.Y, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="Width (mm)" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Properties.Width, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="Height (mm)" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Properties.Height, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="Rotation" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Properties.Rotation, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource FormFieldLabelStyle}" Text="Opacity %" />
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Properties.OpacityPercent, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
