<UserControl x:Class="IDStack.Views.DataImport.DataImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Data Import" />
            <TextBlock Style="{StaticResource BodyTextStyle}"
                       Text="① Import front/back designs + Excel + photos → ② Map placeholders per side → ③ Preview and validate."
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Step tabs -->
        <ListBox Grid.Row="1" Margin="0,16,0,12" SelectedIndex="{Binding SelectedStep}"
                 BorderThickness="0" Background="Transparent">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Resources>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="14,6" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
            <ListBoxItem Content="1. Import" />
            <ListBoxItem Content="2. Mapping" />
            <ListBoxItem Content="3. Preview &amp; Validate" />
        </ListBox>

        <!-- Step content -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16">
            <Grid>

                <!-- ======== Step 1: Import (front/back designs + Excel + photos) ======== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowImportStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="4">
                        <!-- Designs side by side -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Card designs" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Front design -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding FrontDesign.Label}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Browse front…"
                                            AutomationProperties.Name="Browse Front Design"
                                            Click="OnBrowseFrontDesignClick" MinWidth="140" />
                                    <TextBlock Text="{Binding FrontDesign.FileName}" VerticalAlignment="Center"
                                               Margin="10,0,0,0" FontWeight="SemiBold" />
                                </WrapPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Background="{StaticResource SurfaceHoverBrush}"
                                        Height="150" Width="240" Margin="0,8,0,0" HorizontalAlignment="Left">
                                    <Grid>
                                        <Image Source="{Binding FrontDesign.Preview}" Stretch="Uniform" Margin="4" />
                                        <TextBlock Text="No design loaded" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding FrontDesign.HasDesign, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding FrontDesign.StatusText}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Back design -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding BackDesign.Label}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Browse back…"
                                            AutomationProperties.Name="Browse Back Design"
                                            Click="OnBrowseBackDesignClick" MinWidth="140" />
                                    <TextBlock Text="{Binding BackDesign.FileName}" VerticalAlignment="Center"
                                               Margin="10,0,0,0" FontWeight="SemiBold" />
                                </WrapPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Background="{StaticResource SurfaceHoverBrush}"
                                        Height="150" Width="240" Margin="0,8,0,0" HorizontalAlignment="Left">
                                    <Grid>
                                        <Image Source="{Binding BackDesign.Preview}" Stretch="Uniform" Margin="4" />
                                        <TextBlock Text="Optional — no back design" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding BackDesign.HasDesign, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding BackDesign.StatusText}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Supported: .idcard, .psd. Placeholders are detected automatically. The back design is optional."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0" />

                        <Separator Margin="0,16" />

                        <!-- Excel -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Excel / CSV data file (shared by both sides)" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Browse for data file…"
                                    AutomationProperties.Name="Browse Data File"
                                    Command="{Binding Excel.ImportFileCommand}" MinWidth="170" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear"
                                    Command="{Binding Excel.ClearCommand}" MinWidth="80" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Excel.FileName}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontWeight="SemiBold" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Excel.StatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,4" />
                        <TextBlock Text="Supported: .xlsx, .xls, .csv. The first row must contain column headers."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />

                        <Separator Margin="0,16" />

                        <!-- Photos -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Photo folder" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Browse for photo folder…"
                                    AutomationProperties.Name="Browse Photo Folder"
                                    Command="{Binding Photos.BrowseFolderCommand}" MinWidth="180" />
                            <TextBlock Text="{Binding Photos.FolderPath}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontWeight="SemiBold" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Photos.StatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,4" />
                        <TextBlock Text="Supported: .jpg, .png, .bmp, .tif. Photos are matched to rows by file name."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ======== Step 2: Mapping (front and back groups separately) ======== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowMappingStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Detected placeholders" />
                        <TextBlock Text="Rename a placeholder if its detected name is confusing, then map an Excel column to each text placeholder. Photos map by file name to the chosen column."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,10" />

                        <!-- Front / Back group toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="Front side" AutomationProperties.Name="Front Mapping Tab"
                                         Command="{Binding ShowFrontMappingCommand}"
                                         IsChecked="{Binding ShowFrontMapping, Mode=OneWay}" Margin="0,0,12,0" />
                            <RadioButton Content="Back side" AutomationProperties.Name="Back Mapping Tab"
                                         Command="{Binding ShowBackMappingCommand}"
                                         IsChecked="{Binding ShowBackMapping, Mode=OneWay}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ActivePlaceholders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding IsBound, Converter={StaticResource BoolToCheckConverter}}"
                                                   VerticalAlignment="Center" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Margin="0,0,12,0" />
                                        <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.AvailableColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding BoundColumn}" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding SampleText}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="✓ = mapped. Photo matching uses the column chosen on the import step; file names (without extension) are matched against cell values."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ======== Step 3: Preview & Validate ======== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowPreviewStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Data preview" />
                        <DataGrid ItemsSource="{Binding PreviewTable}" AutoGenerateColumns="True"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                                  MaxHeight="220" Margin="0,8,0,0"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="White" BorderBrush="{StaticResource BorderBrush}" />

                        <Separator Margin="0,16" />

                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Validation" />
                        <TextBlock Text="{Binding ValidationSummary}" FontWeight="SemiBold" Margin="0,4,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="ID column for duplicate check:" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding AvailableColumns}"
                                      SelectedItem="{Binding IdColumnName}" Width="220" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Re-run validation"
                                    AutomationProperties.Name="Validate Data"
                                    Command="{Binding ValidateCommand}" MinWidth="130" Margin="12,0,0,0" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Issues}" MaxHeight="200"
                                 BorderBrush="{StaticResource BorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <TextBlock Text="{Binding Severity}" Width="70" FontWeight="Bold" />
                                        <TextBlock Text="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer: status + navigation -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Next: Mapping →"
                    AutomationProperties.Name="Next Mapping"
                    Command="{Binding GoToMappingCommand}" MinWidth="140" Margin="8,0,0,0"
                    Visibility="{Binding ShowImportStep, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Content="← Back to Import"
                    Command="{Binding BackToImportCommand}" MinWidth="120"
                    Visibility="{Binding ShowMappingStep, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Next: Preview →"
                    AutomationProperties.Name="Next Preview"
                    Command="{Binding GoToPreviewCommand}" MinWidth="140" Margin="8,0,0,0"
                    Visibility="{Binding ShowMappingStep, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                       MaxWidth="620" />
        </DockPanel>
    </Grid>
</UserControl>
