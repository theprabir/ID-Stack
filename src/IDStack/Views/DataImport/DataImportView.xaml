<UserControl x:Class="IDStack.Views.DataImport.DataImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Data Import" />
            <TextBlock Style="{StaticResource BodyTextStyle}"
                       Text="Import Excel/CSV data, map columns to placeholders, match photos, then validate before generation."
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Step tabs -->
        <ListBox Grid.Row="1" Margin="0,16,0,12" SelectedIndex="{Binding SelectedStep}"
                 BorderThickness="0" Background="Transparent">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Resources>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="14,6" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Resources>
            <ListBoxItem Content="1. Excel File" />
            <ListBoxItem Content="2. Column Mapping" />
            <ListBoxItem Content="3. Photos" />
            <ListBoxItem Content="4. Validation" />
        </ListBox>

        <!-- Step content -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16">
            <Grid>

                <!-- Step 0: Excel -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowExcelStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Excel / CSV data file" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Browse for data file…"
                                    AutomationProperties.Name="Browse Data File"
                                    Command="{Binding Excel.ImportFileCommand}" MinWidth="170" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear"
                                    Command="{Binding Excel.ClearCommand}" MinWidth="80" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Excel.FileName}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontWeight="SemiBold" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Excel.StatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,4" />

                        <TextBlock Text="Supported: .xlsx, .xls, .csv. The first row must contain column headers."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Step 1: Column mapping -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowMappingStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Map placeholders to columns" />
                        <TextBlock Text="{Binding Mapping.StatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10" />

                        <ItemsControl ItemsSource="{Binding Mapping.Mappings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}"
                                                   VerticalAlignment="Center" TextAlignment="Center"
                                                   FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="{Binding PlaceholderName}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableColumns}"
                                                  SelectedItem="{Binding ColumnName}" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding SampleValue}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="⚠ marks a required placeholder that is not mapped yet. Sample values come from the first data row."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Step 2: Photos -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowPhotosStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Photo folder" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Browse for photo folder…"
                                    AutomationProperties.Name="Browse Photo Folder"
                                    Command="{Binding Photos.BrowseFolderCommand}" MinWidth="180" />
                            <TextBlock Text="{Binding Photos.FolderPath}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontWeight="SemiBold" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Photos.StatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,4" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Match photos by column" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Mapping.AvailableColumns}"
                                          SelectedItem="{Binding Photos.MatchColumnName}" />
                                <TextBlock Text="Photo file names (without extension) are matched against values in this column."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Match photos to rows"
                                        AutomationProperties.Name="Match Photos"
                                        Command="{Binding Photos.RematchCommand}" Margin="0,12,0,0" MinWidth="160"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                            <ListBox Grid.Column="1" ItemsSource="{Binding Photos.Photos}" MaxHeight="340"
                                     BorderBrush="{StaticResource BorderBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="🖼" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding FileName}" />
                                            <TextBlock Text="{Binding MatchKey, StringFormat='  →  {0}'}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Step 3: Validation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowValidationStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Validation report" />
                        <TextBlock Text="{Binding ValidationSummary}" FontWeight="SemiBold" Margin="0,4,0,10" />

                        <TextBlock Text="ID column for duplicate check:" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Mapping.AvailableColumns}"
                                  SelectedItem="{Binding IdColumnName}" Width="240" HorizontalAlignment="Left" />

                        <ListBox ItemsSource="{Binding Issues}" MaxHeight="320" Margin="0,12,0,0"
                                 BorderBrush="{StaticResource BorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <TextBlock Text="{Binding Severity}" Width="70" FontWeight="Bold" />
                                        <TextBlock Text="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer status -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Validate data…"
                    AutomationProperties.Name="Validate Data"
                    Command="{Binding ValidateCommand}" MinWidth="130" Margin="12,0,0,0" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                       MaxWidth="700" />
        </DockPanel>
    </Grid>
</UserControl>
