<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary palette -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#1E3A8A" />

    <!-- Neutral palette (dark theme) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#334155" />
    <SolidColorBrush x:Key="BorderBrush" Color="#334155" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />

    <!-- Shell chrome -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#E2E8F0" />


</ResourceDictionary>
