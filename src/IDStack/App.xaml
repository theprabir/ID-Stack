<Application x:Class="IDStack.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IDStack.ViewModels"
             xmlns:converters="clr-namespace:IDStack.Converters"
             xmlns:vmed="clr-namespace:IDStack.ViewModels.TemplateEditor"
             xmlns:views="clr-namespace:IDStack.Views"              xmlns:viewed="clr-namespace:IDStack.Views.TemplateEditor"
              xmlns:vmd="clr-namespace:IDStack.ViewModels.DataImport"
              xmlns:viewsd="clr-namespace:IDStack.Views.DataImport"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBoxes.xaml" />
                <ResourceDictionary Source="Resources/Styles/Panels.xaml" />
                <ResourceDictionary Source="Resources/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
            <converters:MillimeterToPixelConverter x:Key="MillimeterToPixelConverter" />
            <converters:SideTypeToBoolConverter x:Key="SideTypeToBoolConverter" />
            <converters:BoolToEyeConverter x:Key="BoolToEyeConverter" />
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
            <converters:BoolToCheckConverter x:Key="BoolToCheckConverter" />

            <!-- Navigation: ViewModel -> View mapping -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmed:TemplateEditorViewModel}">
                <viewed:TemplateEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
                <views:PlaceholderPageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmd:DataImportViewModel}">
                <viewsd:DataImportView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
