<UserControl x:Class="IDCardSoftware.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitleStyle}"
                       Text="{Binding WelcomeText}" />
            <TextBlock Style="{StaticResource BodyTextStyle}"
                       Text="{Binding SubtitleText}"
                       Margin="0,0,0,20" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}"
                               Text="{Binding QuickActionsHeader}" />
                    <WrapPanel>
                        <Button Content="{Binding NewTemplateActionText}" Command="{Binding NewTemplateCommand}" />
                        <Button Content="{Binding TemplateLibraryActionText}" Command="{Binding OpenTemplateLibraryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="{Binding ImportExcelActionText}" Command="{Binding ImportExcelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Content="{Binding ImportPsdActionText}" Command="{Binding ImportPsdCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}"
                               Text="{Binding ComingSoonHeader}" />
                    <TextBlock Style="{StaticResource BodyTextStyle}"
                               Text="{Binding ComingSoonText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
